enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email                 String        @unique
  passwordHash          String
  displayName           String
  storefrontName        String?
  bio                   String?
  avatarUrl             String?
  accountStatus         AccountStatus @default(ACTIVE)
  activeOrganizationId  String?       @db.ObjectId

  isDeleted Boolean  @default(false)
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authSessions               AuthSession[]             @relation("UserAuthSessions")
  accountRecoveryTokens      AccountRecoveryToken[]    @relation("UserAccountRecoveryTokens")
  accountStatusEvents        AccountStatusEvent[]      @relation("UserAccountStatusEvents")
  actedAccountStatusEvents   AccountStatusEvent[]      @relation("AccountStatusEventActor")

  sentConnectionRequests     ConnectionRequest[]       @relation("ConnectionRequestRequester")
  receivedConnectionRequests ConnectionRequest[]       @relation("ConnectionRequestReceiver")
  lowConnections             Connection[]              @relation("ConnectionLowUser")
  highConnections            Connection[]              @relation("ConnectionHighUser")
  connectionNotifications    ConnectionNotification[]  @relation("ConnectionNotificationUser")

  ownedOrganizations               Organization[]            @relation("OrganizationOwner")
  organizationMemberships          OrganizationMembership[]  @relation("OrganizationMembershipUser")
  organizationInvitesReceived      OrganizationInvite[]      @relation("OrganizationInviteeUser")
  organizationInvitesSent          OrganizationInvite[]      @relation("OrganizationInviterUser")
  organizationJoinRequests         OrganizationJoinRequest[] @relation("OrganizationJoinRequester")
  reviewedOrganizationJoinRequests OrganizationJoinRequest[] @relation("OrganizationJoinReviewer")

  productListings            ProductListing[]              @relation("ProductListingSeller")
  listingLifecycleEvents     ListingLifecycleEvent[]       @relation("ListingLifecycleEventActor")
  suggestionLayoutPreference SuggestionLayoutPreference?   @relation("UserSuggestionLayoutPreference")

  soldTransactions            Transaction[]           @relation("TransactionSeller")
  boughtTransactions          Transaction[]           @relation("TransactionBuyer")
  recordedTransactions        Transaction[]           @relation("TransactionRecorder")
  uploadedTransactionInvoices TransactionInvoice[]    @relation("TransactionInvoiceUploader")
  transactionAdjustments      TransactionAdjustment[] @relation("TransactionAdjustmentActor")

  ownedBorrowingRecords        BorrowingRecord[]     @relation("BorrowingRecordOwner")
  counterpartyBorrowingRecords BorrowingRecord[]     @relation("BorrowingRecordCounterparty")
  repayments                   Repayment[]           @relation("RepaymentActor")
  settlementNotes              SettlementNote[]      @relation("SettlementNoteActor")
  borrowingAuditEntries        BorrowingAuditEntry[] @relation("BorrowingAuditEntryActor")

  commerceMetricSnapshots  CommerceMetricSnapshot[]  @relation("CommerceMetricSnapshotUser")
  borrowingMetricSnapshots BorrowingMetricSnapshot[] @relation("BorrowingMetricSnapshotUser")
  reportViewPresets        ReportViewPreset[]        @relation("ReportViewPresetUser")
  reportExportJobs         ReportExportJob[]         @relation("ReportExportJobUser")

  @@index([accountStatus])
  @@index([activeOrganizationId])
  @@map("users")
}
