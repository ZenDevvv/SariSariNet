model BorrowingMetricSnapshot {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId                 String   @db.ObjectId
  rangeStart             DateTime
  rangeEnd               DateTime
  totalLent              Float
  totalBorrowed          Float
  outstandingReceivable  Float
  outstandingPayable     Float
  overdueCount           Int
  computedAt             DateTime
  sourceVersion          Int

  isDeleted Boolean  @default(false)
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("BorrowingMetricSnapshotUser", fields: [userId], references: [id])

  @@index([userId, computedAt])
  @@index([userId, rangeStart, rangeEnd, sourceVersion])
  @@map("borrowing_metric_snapshots")
}
