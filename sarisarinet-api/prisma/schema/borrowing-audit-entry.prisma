enum BorrowingAuditEventType {
  RECORD_CREATED
  REPAYMENT_POSTED
  STATUS_UPDATED
  SETTLEMENT_NOTE_ADDED
  RECORD_CLOSED
  TERMS_UPDATED
}

model BorrowingAuditEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  borrowingRecordId String                @db.ObjectId
  eventType         BorrowingAuditEventType
  payload           Json
  actorUserId       String                @db.ObjectId

  isDeleted Boolean  @default(false)
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowingRecord BorrowingRecord @relation("BorrowingRecordAuditEntries", fields: [borrowingRecordId], references: [id])
  actorUser       User            @relation("BorrowingAuditEntryActor", fields: [actorUserId], references: [id])

  @@index([borrowingRecordId, createdAt])
  @@map("borrowing_audit_entries")
}
