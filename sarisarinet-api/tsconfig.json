{
	"compilerOptions": {
		"target": "ES6",
		"strict": true,
		"module": "commonjs",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": ".",
		"typeRoots": ["./node_modules/@types", "type"],
		"moduleResolution": "node",
		"sourceMap": true,
		"resolveJsonModule": true
	},
	"include": [
		"app/modules/**/*.ts",
		"index.ts",
		"middleware/cache.ts",
		"middleware/security.ts",
		"middleware/verifyToken.ts",
		"config/**/*.ts",
		"zod/common.zod.ts",
		"zod/object-id.zod.ts",
		"zod/modules/**/*.ts"
	],
	"exclude": ["node_modules"]
}
